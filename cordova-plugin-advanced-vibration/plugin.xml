<?xml version="1.0" encoding="UTF-8"?>
<plugin id="cordova-plugin-advanced-vibration"
    version="1.0.0"
    xmlns="http://apache.org/cordova/ns/plugins"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <name>AdvancedVibration</name>
    <js-module src="www/AdvancedVibration.js" name="AdvancedVibration">
        <clobbers target="AdvancedVibration" />
    </js-module>
    <platform name="android">
        <source-file src="src/android/AdvancedVibration.java" target-dir="src/com/example/vibration" />
    </platform>
</plugin>
